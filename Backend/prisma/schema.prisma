generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 🔐 MÓDULO: SEGURIDAD Y USUARIOS
// ==========================================

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  password           String
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  roles              UserRole[]
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  emailSent          Boolean    @default(false)
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String?
  key         String           @unique
  description String?
  isActive    Boolean          @default(true)
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Setting {
  id    String @id @default(uuid())
  name  String @unique
  value String @db.LongText
}

// ==========================================
// 🏠 MÓDULO: INICIO / CMS
// ==========================================

model HomeSection {
  id         String          @id @default(uuid())
  key        String          @unique
  title      String
  type       HomeSectionType
  isActive   Boolean         @default(true)
  orderIndex Int

  carouselItems    CarouselItem[]
  accessCards      AccessCardItem[]
  calendar         CalendarConfig?
  derechohabiencia DerechohabienciaConfig?
  alert            AlertMessage?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model AlertMessage {
  id          String      @id @default(uuid())
  title       String
  description String      @db.LongText
  author      String
  color       String
  icon        String?
  isActive    Boolean     @default(true)
  sectionId   String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?   @updatedAt
  section     HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model CarouselItem {
  id          String  @id @default(uuid())
  imageName   String?
  imageUrl    String?
  imagePath   String?
  type        String
  title       String?
  description String? @db.LongText
  orderIndex  Int     @default(0)
  isActive    Boolean @default(true)
  url         String?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([fileId])
}

model AccessCardItem {
  id          String  @id @default(uuid())
  title       String
  badge       String?
  color       String
  description String? @db.LongText
  icon        String?
  url         String?
  type        String?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  orderIndex Int
  isActive   Boolean     @default(true)
  sectionId  String
  section    HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([fileId])
}

model CalendarConfig {
  id          String  @id @default(uuid())
  year        Int
  title       String
  icon        String
  color       String
  description String? @db.LongText

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  sectionId String      @unique
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([sectionId])
  @@index([fileId])
}

model DerechohabienciaConfig {
  id          String                 @id @default(uuid())
  title       String
  icon        String
  color       String
  description String?                @db.LongText
  sectionId   String                 @unique
  links       DerechohabienciaLink[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime?              @updatedAt
  section     HomeSection            @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model DerechohabienciaLink {
  id                       String                  @id @default(uuid())
  title                    String
  url                      String
  orderIndex               Int                     @default(0)
  isActive                 Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  derechohabienciaConfigId String?
  derechohabienciaConfig   DerechohabienciaConfig? @relation(fields: [derechohabienciaConfigId], references: [id], onDelete: Cascade)

  @@index([derechohabienciaConfigId])
}

// ==========================================
// 📞 MÓDULO: DIRECTORIO
// ==========================================

model Directory {
  id        String  @id @default(uuid())
  phone     String
  levelId   String
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  boss      String?
  email     String?
  name      String
  secretary String?

  @@index([levelId])
}

model Level {
  id          String      @id @default(uuid())
  name        String      @unique
  directories Directory[]
}

// ==========================================
// 🛠️ MÓDULO: SISTEMAS Y MACROPROCESOS
// ==========================================

model System {
  id          String  @id @default(uuid())
  acronym     String?
  name        String?
  description String  @db.LongText
  color       String
  icon        String
  url         String?
  type        String?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([fileId])
}

model Area {
  id          String    @id @default(uuid())
  name        String
  category    String
  manager     String?
  description String?   @db.LongText
  manuals     Manual[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model ManualType {
  id        String         @id @default(uuid())
  name      String
  color     String
  category  ManualCategory @default(STANDARD)
  manuals   Manual[]
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt
}

model Manual {
  id String @id @default(uuid())

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  areaId       String
  manualTypeId String

  area       Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  manualType ManualType @relation(fields: [manualTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([areaId])
  @@index([manualTypeId])
  @@index([fileId])
}

// ==========================================
// 📊 MÓDULO: INFORMES Y ESTADÍSTICAS
// ==========================================

model Cie10 {
  id   String @id @default(uuid())
  name String @db.LongText
}

model Period {
  id   String @id @default(uuid())
  year Int    @unique

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id          String  @id @default(uuid())
  title       String
  description String? @db.LongText

  type  ReportType @default(MONTHLY)
  month Int?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  periodId String?
  period   Period? @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, month, type])
  @@index([periodId])
  @@index([type])
  @@index([fileId])
}

// ==========================================
// 🤝 MÓDULO: CONVENIOS (🚨 Mantienen ids como Int)
// ==========================================

model AgreementPerson {
  id   Int        @id @default(autoincrement())
  name String
  type PersonType @default(HOLDER)

  parents  FamilyLink[] @relation("DependentToParents")
  children FamilyLink[] @relation("ParentToChildren")

  zoneId  Int
  zone    Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([groupId])
}

model FamilyLink {
  parentId    Int
  dependentId Int

  parent    AgreementPerson @relation("ParentToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  dependent AgreementPerson @relation("DependentToParents", fields: [dependentId], references: [id], onDelete: Cascade)

  @@id([parentId, dependentId])
  @@index([parentId])
  @@index([dependentId])
}

model Zone {
  id   Int    @id @default(autoincrement())
  name String @unique

  persons AgreementPerson[]
}

model Group {
  id   Int    @id @default(autoincrement())
  name String @unique

  persons AgreementPerson[]
}

// ==========================================
// 🏥 MÓDULO: CBIM Y CLÍNICA (GPC)
// ==========================================

model Cbim {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String     @db.LongText
  description String     @db.LongText
  sp          String?
  fpgc        String?
  cbt_cae     CbtCaeType @default(CAE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicalPracticeGuideline {
  id    String @id @default(uuid())
  code  String
  title String

  fileERId String?
  fileER   File?   @relation("GuidelineER", fields: [fileERId], references: [id])
  fileRRId String?
  fileRR   File?   @relation("GuidelineRR", fields: [fileRRId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([fileERId])
  @@index([fileRRId])
}

model Category {
  id                 String                      @id @default(uuid())
  name               String                      @unique
  clinicalGuidelines ClinicalPracticeGuideline[]
}

model Pbm {
  id    String @id @default(uuid())
  title String

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  @@index([fileId])
}

model Gpc {
  id          String @id @default(uuid())
  orderIndex  Int
  title       String
  description String @db.LongText

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  cycleId String
  cycle   Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, orderIndex])
  @@index([cycleId])
  @@index([fileId])
}

model Cycle {
  id   String @id @default(uuid())
  name String
  gpcs Gpc[]
}

model CareProtocol {
  id          String @id @default(uuid())
  title       String
  description String

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  categoryCareProtocolsId String?
  category                CategoryCareProtocol? @relation(fields: [categoryCareProtocolsId], references: [id], onDelete: SetNull)

  @@index([categoryCareProtocolsId])
  @@index([fileId])
}

model CategoryCareProtocol {
  id            String         @id @default(uuid())
  name          String
  careProtocols CareProtocol[]
}

model Code {
  id              String       @id @default(uuid())
  name            String
  code            String
  color           String
  icon            String
  description     String       @db.LongText
  categoryCodesId String
  category        CategoryCode @relation(fields: [categoryCodesId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?    @updatedAt

  @@index([categoryCodesId])
}

model CategoryCode {
  id    String @id @default(uuid())
  name  String @unique
  codes Code[]
}

model AdverseEvent {
  id    String @id @default(uuid())
  title String
  type  String @unique

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  @@index([fileId])
}

// ==========================================
// 📥 MÓDULO: DESCARGAS
// ==========================================

model DownloadArea {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  icon     String
  color    String
  isActive Boolean @default(true)

  messages DownloadAreaMessage[]
  sections DownloadSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model DownloadAreaMessage {
  id      String      @id @default(uuid())
  title   String
  content String
  icon    String?
  type    MessageType @default(INFO)

  isActive Boolean @default(true)
  order    Int?

  startAt DateTime?
  endAt   DateTime?

  areaId String
  area   DownloadArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([isActive])
}

model DownloadSection {
  id       String  @id @default(uuid())
  name     String
  order    Int?
  isActive Boolean @default(true)

  areaId String
  area   DownloadArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  categories DownloadCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([isActive])
}

model DownloadCategory {
  id       String  @id @default(uuid())
  name     String
  order    Int?
  isActive Boolean @default(true)

  sectionId String
  section   DownloadSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  files DownloadFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([isActive])
}

model DownloadFile {
  id          String  @id @default(uuid())
  name        String
  description String? @db.LongText

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  type FileType @default(DOCUMENT)

  isNew    Boolean @default(false)
  isActive Boolean @default(true)
  order    Int?

  categoryId String
  category   DownloadCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([type])
  @@index([fileId])
}

// ==========================================
// 🔬 MÓDULO: ESPECÍFICOS (Vigilancia, Normas, etc)
// ==========================================

model Uveh {
  id          String  @id @default(uuid())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  categoryId String
  category   UvehCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([fileId])
}

model UvehCategory {
  id   String @id @default(uuid())
  name String

  uvehs Uveh[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Standard {
  id          String  @id @default(uuid())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  categoryId String
  category   StandardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([fileId])
}

model StandardCategory {
  id   String @id @default(uuid())
  name String

  standards Standard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Juristic {
  id          String  @id @default(uuid())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileId])
}

model Certification {
  id          String  @id @default(uuid())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  sectionId String
  section   CertificationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([fileId])
}

model CertificationSection {
  id   String @id @default(uuid())
  name String

  certifications Certification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftType {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files ShiftFile[]
}

model ShiftFile {
  id String @id @default(uuid())

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  type      ShiftFileType
  shiftId   String
  createdAt DateTime      @default(now())

  shift ShiftType @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([type, shiftId])
  @@index([shiftId])
  @@index([fileId])
}

// ==========================================
// 📄 MOTOR CENTRALIZADO DE ARCHIVOS
// ==========================================

model File {
  id       String  @id @default(uuid())
  name     String?
  path     String?
  size     Int?
  mimeType String?

  url      String?
  provider String?

  createdAt DateTime @default(now())

  carouselItems        CarouselItem[]
  calendarConfigs      CalendarConfig[]
  accessCardItems      AccessCardItem[]
  systems              System[]
  gpcs                 Gpc[]
  manuals              Manual[]
  reports              Report[]
  clinicalGuidelines   ClinicalPracticeGuideline[] @relation("GuidelineER")
  clinicalGuidelinesRR ClinicalPracticeGuideline[] @relation("GuidelineRR")
  pbms                 Pbm[]
  careProtocols        CareProtocol[]
  adverseEvents        AdverseEvent[]
  downloadFiles        DownloadFile[]
  uvehs                Uveh[]
  standards            Standard[]
  juristics            Juristic[]
  certifications       Certification[]
  shiftFiles           ShiftFile[]
}

// ==========================================
// 📋 ENUMS GLOBALES
// ==========================================

enum HomeSectionType {
  ALERT
  CAROUSEL
  CALENDAR
  DERECHOHABIENCIA
  ACCESS_CARD
}

enum ManualCategory {
  STANDARD
  EXTRA
}

enum ReportType {
  MONTHLY
  ANNUAL
  STATISTICAL
  EXTRA
}

enum PersonType {
  HOLDER
  DEPENDENT
}

enum CbtCaeType {
  CAE
  CBT
}

enum MessageType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum ShiftFileType {
  CALENDAR
  INDEX
}

enum FileType {
  DOCUMENT
  IMAGE
}
