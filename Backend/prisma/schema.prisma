// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Setting {
  id    String @id @default(uuid())
  name  String @unique
  value String @db.LongText
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   Json
  createdAt DateTime @default(now())
}

model Carousel {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String
  url         String
  createdAt   DateTime @default(now())
  is_visible  Boolean  @default(true)
}

model SectionHome {
  id        Int      @id @default(autoincrement())
  content   String?
  createdAt DateTime @default(now())
  title     String
  image     String?
  url       String?
}

model Ditectory {
  id        String  @id @default(uuid())
  phone     String
  level     String
  boss      String?
  email     String?
  name      String
  secretary String?
}

// Sistemas de consulta
model Systems {
  id          String    @id @unique @default(uuid())
  name        String
  description String    @db.Text
  color       String
  icon        String
  url         String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model Area {
  id          String    @id @unique @default(uuid())
  name        String
  category    String
  manager     String?
  description String?
  manuals     Manual[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model ManualType {
  id        String         @id @unique @default(uuid())
  name      String
  color     String
  category  ManualCategory @default(STANDARD)
  manuals   Manual[]
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt
}

model Manual {
  id           String  @id @unique @default(uuid())
  fileName     String
  storedName   String?
  filePath     String?
  fileSize     Int?
  mimeType     String?
  areaId       String
  manualTypeId String

  area       Area       @relation(fields: [areaId], references: [id])
  manualType ManualType @relation(fields: [manualTypeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([areaId])
  @@index([manualTypeId])
}

enum ManualCategory {
  STANDARD // MO, MP, DxSit, PT
  EXTRA // Código Ético, Normatividad, etc
}
