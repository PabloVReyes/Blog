// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Setting {
  id    String @id @default(uuid())
  name  String @unique
  value String @db.LongText
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   Json
  createdAt DateTime @default(now())
}

// Inicio
model HomeSection {
  id         String          @id @default(uuid())
  key        String          @unique
  title      String
  type       HomeSectionType
  isActive   Boolean         @default(true)
  orderIndex Int

  carouselItems    CarouselItem[]
  accessCards      AccessCardItem[]
  calendar         CalendarConfig?
  derechoambiencia DerechohabienciaConfig?
  alert            AlertMessage?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model AlertMessage {
  id          String      @id @default(uuid())
  title       String
  description String      @db.LongText
  author      String
  color       String
  icon        String?
  isActive    Boolean     @default(true)
  sectionId   String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?   @updatedAt
  section     HomeSection @relation(fields: [sectionId], references: [id])
}

model CarouselItem {
  id          String  @id @default(uuid())
  imageName   String
  imageUrl    String
  imagePath   String
  type        String
  title       String?
  description String? @db.LongText
  orderIndex  Int     @default(0)
  isActive    Boolean @default(true)
  url         String?
  fileName    String?
  storedName  String?
  filePath    String?
  fileSize    Int?
  mimeType    String?

  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessCardItem {
  id          String      @id @default(uuid())
  title       String
  badge       String?
  color       String
  description String?     @db.LongText
  icon        String?
  url         String?
  type        String?
  fileName    String?
  storedName  String?
  filePath    String?
  fileSize    Int?
  mimeType    String?
  orderIndex  Int
  isActive    Boolean     @default(true)
  sectionId   String
  section     HomeSection @relation(fields: [sectionId], references: [id])
}

model CalendarConfig {
  id          String      @id @default(uuid())
  year        Int
  title       String
  icon        String
  color       String
  description String?     @db.LongText
  sectionId   String      @unique
  fileName    String?
  storedName  String?
  filePath    String?
  fileSize    Int?
  mimeType    String?
  section     HomeSection @relation(fields: [sectionId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?   @updatedAt
}

model DerechohabienciaConfig {
  id          String                 @id @default(uuid())
  title       String
  icon        String
  color       String
  description String?                @db.LongText
  sectionId   String                 @unique
  links       DerechohabienciaLink[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime?              @updatedAt
  section     HomeSection            @relation(fields: [sectionId], references: [id])
}

model DerechohabienciaLink {
  id                       String                  @id @default(uuid())
  title                    String
  url                      String
  orderIndex               Int                     @default(0)
  isActive                 Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  derechohabienciaConfig   DerechohabienciaConfig? @relation(fields: [derechohabienciaConfigId], references: [id])
  derechohabienciaConfigId String?
}

enum HomeSectionType {
  ALERT
  CAROUSEL
  CALENDAR
  DERECHOHABIENCIA
  ACCESS_CARD
}

// Directorio
model Ditectory {
  id        String  @id @default(uuid())
  phone     String
  level     String
  boss      String?
  email     String?
  name      String
  secretary String?
}

// Sistemas de consulta
model Systems {
  id          String  @id @unique @default(uuid())
  acronym     String?
  name        String?
  description String  @db.LongText
  color       String
  icon        String
  url         String?

  type       String?
  fileName   String?
  storedName String?
  filePath   String?
  fileSize   Int?
  mimeType   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Area {
  id          String    @id @unique @default(uuid())
  name        String
  category    String
  manager     String?
  description String?   @db.LongText
  manuals     Manual[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model ManualType {
  id        String         @id @unique @default(uuid())
  name      String
  color     String
  category  ManualCategory @default(STANDARD)
  manuals   Manual[]
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt
}

model Manual {
  id           String  @id @unique @default(uuid())
  fileName     String
  storedName   String?
  filePath     String?
  fileSize     Int?
  mimeType     String?
  areaId       String
  manualTypeId String

  area       Area       @relation(fields: [areaId], references: [id])
  manualType ManualType @relation(fields: [manualTypeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([areaId])
  @@index([manualTypeId])
}

enum ManualCategory {
  STANDARD // MO, MP, DxSit, PT
  EXTRA // Código Ético, Normatividad, etc
}

model cie10 {
  id   String @id @unique @default(uuid())
  name String @db.LongText
}

// Informes Mensuales
model Period {
  id   String @id @default(uuid())
  year Int    @unique

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id          String  @id @default(uuid())
  title       String
  description String? @db.LongText

  type  ReportType @default(MONTHLY)
  month Int? // solo para mensuales (1-12)

  fileName String
  filePath String
  fileSize Int
  mimeType String

  periodId String
  period   Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, month, type]) // evita duplicados mensuales
  @@index([periodId])
  @@index([type])
}

enum ReportType {
  MONTHLY
  ANNUAL
  STATISTICAL
  EXTRA
}

model AgreementPerson {
  id   Int        @id @default(autoincrement())
  name String
  type PersonType @default(HOLDER)

  // Relaciones
  // Quiénes son mis titulares (si soy dependiente)
  parents  FamilyLink[] @relation("DependentToParents")
  // Quiénes son mis dependientes (si soy titular)
  children FamilyLink[] @relation("ParentToChildren")

  zoneId  Int
  zone    Zone  @relation(fields: [zoneId], references: [id])
  groupId Int
  group   Group @relation(fields: [groupId], references: [id])
}

model FamilyLink {
  parentId    Int
  dependentId Int

  parent    AgreementPerson @relation("ParentToChildren", fields: [parentId], references: [id])
  dependent AgreementPerson @relation("DependentToParents", fields: [dependentId], references: [id])

  @@id([parentId, dependentId]) // Llave primaria compuesta
}

model Zone {
  id   Int    @id @default(autoincrement())
  name String @unique

  persons AgreementPerson[]
}

model Group {
  id   Int    @id @default(autoincrement())
  name String @unique

  persons AgreementPerson[]
}

enum PersonType {
  HOLDER
  DEPENDENT
}

model Cbim {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String     @db.LongText
  description String     @db.LongText
  sp          String?
  fpgc        String?
  cbt_cae     CBTCAEType @default(CAE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CBTCAEType {
  CAE
  CBT
}

model ClinicalPracticeGuidelines {
  id    String @id @default(uuid())
  code  String
  title String

  // Evidencias y Recomendaciones
  fileNameER String
  filePathER String
  fileSizeER Int
  mimeTypeER String

  // Referencia Rapida
  fileNameRR String
  filePathRR String
  fileSizeRR Int
  mimeTypeRR String

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
}

model Category {
  id                         String                       @id @default(uuid())
  name                       String                       @unique
  clinicalPracticeGuidelines ClinicalPracticeGuidelines[]
}

model pbm {
  id    String @id @default(uuid())
  title String

  fileName String
  filePath String
  fileSize Int
  mimeType String
}
