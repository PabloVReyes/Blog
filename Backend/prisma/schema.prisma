generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Setting {
  id    String @id @default(uuid())
  name  String @unique
  value String @db.LongText
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   Json
  createdAt DateTime @default(now())
}

model Carousel {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String
  url         String
  createdAt   DateTime @default(now())
  is_visible  Boolean  @default(true)
}

model SectionHome {
  id        Int      @id @default(autoincrement())
  content   String?
  createdAt DateTime @default(now())
  title     String
  image     String?
  url       String?
}

model Ditectory {
  id        String  @id @default(uuid())
  phone     String
  level     String
  boss      String?
  email     String?
  name      String
  secretary String?
}
