// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// Usuarios
model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  active   Boolean @default(true)

  mustChangePassword Boolean @default(false)

  roles       UserRole[]
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  name        String?
  key         String  @unique
  description String?
  active      Boolean @default(true)

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Setting {
  id    String @id @default(uuid())
  name  String @unique
  value String @db.LongText
}

// Limpiando base de datos

////////////
// INICIO //
////////////

model HomeSection {
  id         String          @id @default(uuid())
  key        String          @unique
  title      String
  type       HomeSectionType
  isActive   Boolean         @default(true)
  orderIndex Int

  carouselItems    CarouselItem[]
  accessCards      AccessCardItem[]
  calendar         CalendarConfig?
  derechohabiencia DerechohabienciaConfig?
  alert            AlertMessage?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model AlertMessage {
  id          String      @id @default(uuid())
  title       String
  description String      @db.LongText
  author      String
  color       String
  icon        String?
  isActive    Boolean     @default(true)
  sectionId   String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?   @updatedAt
  section     HomeSection @relation(fields: [sectionId], references: [id])
}

model CarouselItem {
  id          String  @id @default(uuid())
  imageName   String?
  imageUrl    String?
  imagePath   String?
  type        String
  title       String?
  description String? @db.LongText
  orderIndex  Int     @default(0)
  isActive    Boolean @default(true)
  url         String?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessCardItem {
  id          String  @id @default(uuid())
  title       String
  badge       String?
  color       String
  description String? @db.LongText
  icon        String?
  url         String?
  type        String?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  orderIndex Int
  isActive   Boolean     @default(true)
  sectionId  String
  section    HomeSection @relation(fields: [sectionId], references: [id])
}

model CalendarConfig {
  id          String  @id @default(uuid())
  year        Int
  title       String
  icon        String
  color       String
  description String? @db.LongText

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  sectionId String      @unique
  section   HomeSection @relation(fields: [sectionId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model DerechohabienciaConfig {
  id          String                 @id @default(uuid())
  title       String
  icon        String
  color       String
  description String?                @db.LongText
  sectionId   String                 @unique
  links       DerechohabienciaLink[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime?              @updatedAt
  section     HomeSection            @relation(fields: [sectionId], references: [id])
}

model DerechohabienciaLink {
  id                       String                  @id @default(uuid())
  title                    String
  url                      String
  orderIndex               Int                     @default(0)
  isActive                 Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  derechohabienciaConfig   DerechohabienciaConfig? @relation(fields: [derechohabienciaConfigId], references: [id])
  derechohabienciaConfigId String?
}

////////////////
// DIRECTORIO //
////////////////

model Directory {
  id        String  @id @default(uuid())
  phone     String
  level     Level   @relation(fields: [levelId], references: [id])
  boss      String?
  email     String?
  name      String
  secretary String?
  levelId   String
}

// nivel
model Level {
  id          String      @id @default(uuid())
  name        String      @unique
  ditectories Directory[]
}

//////////////////////////
// SISTEMAS DE CONSULTA //
//////////////////////////

model Systems {
  id          String  @id @unique @default(uuid())
  acronym     String?
  name        String?
  description String  @db.LongText
  color       String
  icon        String
  url         String?
  type        String?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

//////////////////
// MACROPORCESO //
//////////////////

model Area {
  id          String    @id @unique @default(uuid())
  name        String
  category    String
  manager     String?
  description String?   @db.LongText
  manuals     Manual[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model ManualType {
  id        String         @id @unique @default(uuid())
  name      String
  color     String
  category  ManualCategory @default(STANDARD)
  manuals   Manual[]
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt
}

model Manual {
  id String @id @unique @default(uuid())

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  areaId       String
  manualTypeId String

  area       Area       @relation(fields: [areaId], references: [id])
  manualType ManualType @relation(fields: [manualTypeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([areaId])
  @@index([manualTypeId])
}

////////////
// CIE 10 //
////////////

model cie10 {
  id   String @id @unique @default(uuid())
  name String @db.LongText
}

////////////////////////
// INFORMES MENSUALES //
////////////////////////

model Period {
  id   String @id @default(uuid())
  year Int    @unique

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id          String  @id @default(uuid())
  title       String
  description String? @db.LongText

  type  ReportType @default(MONTHLY)
  month Int?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  periodId String?
  period   Period? @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, month, type]) // evita duplicados mensuales
  @@index([periodId])
  @@index([type])
}

///////////////
// CONVENIOS //
///////////////

model AgreementPerson {
  id   Int        @id @default(autoincrement())
  name String
  type PersonType @default(HOLDER)

  parents  FamilyLink[] @relation("DependentToParents")
  children FamilyLink[] @relation("ParentToChildren")

  zoneId  Int
  zone    Zone  @relation(fields: [zoneId], references: [id])
  groupId Int
  group   Group @relation(fields: [groupId], references: [id])
}

model FamilyLink {
  parentId    Int
  dependentId Int

  parent    AgreementPerson @relation("ParentToChildren", fields: [parentId], references: [id])
  dependent AgreementPerson @relation("DependentToParents", fields: [dependentId], references: [id])

  @@id([parentId, dependentId])
}

model Zone {
  id   Int    @id @default(autoincrement())
  name String @unique

  persons AgreementPerson[]
}

model Group {
  id   Int    @id @default(autoincrement())
  name String @unique

  persons AgreementPerson[]
}

//////////
// CBIM //
//////////

model Cbim {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String     @db.LongText
  description String     @db.LongText
  sp          String?
  fpgc        String?
  cbt_cae     CBTCAEType @default(CAE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////////
// GUÌAS DE PRACTICA CLINICA //
///////////////////////////////

model ClinicalPracticeGuidelines {
  id    String @id @default(uuid())
  code  String
  title String

  fileERId String?
  fileER   File?   @relation("GuidelineER", fields: [fileERId], references: [id])
  fileRRId String?
  fileRR   File?   @relation("GuidelineRR", fields: [fileRRId], references: [id])

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  @@index([categoryId])
  @@index([fileERId])
  @@index([fileRRId])
}

model Category {
  id                         String                       @id @default(uuid())
  name                       String                       @unique
  clinicalPracticeGuidelines ClinicalPracticeGuidelines[]
}

////////////////////
// ALGORITMOS PBM //
////////////////////

model pbm {
  id    String @id @default(uuid())
  title String

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  @@index([fileId])
}

////////////////////
// ALGORITMOS GPC //
////////////////////

model gpc {
  id          String @id @default(uuid())
  orderIndex  Int
  title       String
  description String @db.LongText

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  cycle   cycle  @relation(fields: [cycleId], references: [id])
  cycleId String

  @@unique([cycleId, orderIndex])
}

model cycle {
  id   String @id @default(uuid())
  name String
  gpcs gpc[]
}

////////////////////////////
// PROTOCOLOS DE ATENCION //
////////////////////////////

model CareProtocols {
  id          String                 @id @default(uuid())
  category    CategoryCareProtocols? @relation(fields: [categoryCareProtocolsId], references: [id])
  title       String
  description String

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  categoryCareProtocolsId String?
}

model CategoryCareProtocols {
  id            String          @id @default(uuid())
  name          String
  careProtocols CareProtocols[]
}

////////////////////////////
// SEGURIDAD DEL PACIENTE //
////////////////////////////

model Codes {
  id              String        @id @default(uuid())
  name            String
  code            String
  color           String
  icon            String
  description     String        @db.LongText
  category        CategoryCodes @relation(fields: [categoryCodesId], references: [id])
  categoryCodesId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt
}

model CategoryCodes {
  id    String  @id @default(uuid())
  name  String  @unique
  codes Codes[]
}

//////////////////////
// EVENTOS ADVERSOS //
//////////////////////

model AdverseEvents {
  id    String @id @default(uuid())
  title String
  type  String @unique

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])
}

// =======================
// AREA
// =======================

model DownloadArea {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  icon     String
  color    String
  isActive Boolean @default(true)

  // Relaciones
  messages DownloadAreaMessage[]
  sections DownloadSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

///////////////
// DESCARGAS //
///////////////

model DownloadAreaMessage {
  id      Int         @id @default(autoincrement())
  title   String
  content String
  icon    String?
  type    MessageType @default(INFO)

  isActive Boolean @default(true)
  order    Int?

  startAt DateTime?
  endAt   DateTime?

  areaId Int
  area   DownloadArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([isActive])
}

model DownloadSection {
  id       Int     @id @default(autoincrement())
  name     String
  order    Int?
  isActive Boolean @default(true)

  areaId Int
  area   DownloadArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  categories DownloadCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([isActive])
}

model DownloadCategory {
  id       Int     @id @default(autoincrement())
  name     String
  order    Int?
  isActive Boolean @default(true)

  sectionId Int
  section   DownloadSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  files DownloadFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([isActive])
}

model DownloadFile {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.LongText

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  type FileType @default(DOCUMENT)

  isNew    Boolean @default(false)
  isActive Boolean @default(true)
  order    Int?

  categoryId Int
  category   DownloadCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([type])
  @@index([fileId])
}

model uveh {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  categoryId Int
  category   uvehCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model uvehCategory {
  id   Int    @id @default(autoincrement())
  name String

  uvehs uveh[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model standards {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  categoryId Int
  category   standardsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model standardsCategory {
  id   Int    @id @default(autoincrement())
  name String

  standards standards[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model juristics {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certification {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.LongText
  isNew       Boolean @default(false)

  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  sectionId Int
  section   CertificationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificationSection {
  id   Int    @id @default(autoincrement())
  name String

  certifications Certification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftType {
  id        Int      @id @default(autoincrement())
  name      String   @unique // "Matutino - Vespertino"
  icon      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files ShiftFile[]
}

model ShiftFile {
  id Int @id @default(autoincrement())

  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  type      ShiftFileType
  shiftId   Int
  createdAt DateTime      @default(now())

  shift ShiftType @relation(fields: [shiftId], references: [id])

  @@unique([type, shiftId]) // Solo un CALENDAR y un INDEX por jornada
}

model File {
  id       String  @id @default(uuid())
  name     String?
  path     String?
  size     Int?
  mimeType String?

  url      String?
  provider String?

  createdAt DateTime @default(now())

  carouselItems        CarouselItem[]
  calendarConfigs      CalendarConfig[]
  accessCardItems      AccessCardItem[]
  systems              Systems[]
  gpcs                 gpc[]
  manuals              Manual[]
  reports              Report[]
  clinicalGuidelines   ClinicalPracticeGuidelines[] @relation("GuidelineER")
  clinicalGuidelinesRR ClinicalPracticeGuidelines[] @relation("GuidelineRR")
  pbms                 pbm[]
  careProtocols        CareProtocols[]
  adverseEvents        AdverseEvents[]
  downloadFiles        DownloadFile[]
}

///////////
// ENUMS //
///////////

enum HomeSectionType {
  ALERT
  CAROUSEL
  CALENDAR
  DERECHOHABIENCIA
  ACCESS_CARD
}

enum ManualCategory {
  STANDARD // MO, MP, DxSit, PT
  EXTRA // Código Ético, Normatividad, etc
}

enum ReportType {
  MONTHLY
  ANNUAL
  STATISTICAL
  EXTRA
}

enum PersonType {
  HOLDER
  DEPENDENT
}

enum CBTCAEType {
  CAE
  CBT
}

enum MessageType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum ShiftFileType {
  CALENDAR
  INDEX
}

enum FileType {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  OTHER
}
