# Puerto en el que corre el servidor backend (API)
PORT=4000

# Configuración de conexión a la base de datos MySQL
DB_HOST=127.0.0.1        # Dirección del servidor de base de datos
DB_PORT=3306             # Puerto estándar de MySQL
DB_USER=app_user         # Usuario de la base de datos (no usar root en producción)
DB_PASSWORD=Str0ngP@ss!  # Contraseña segura del usuario
DB_NAME=app_database     # Nombre de la base de datos

# Entorno de ejecución de Node.js
NODE_ENV=development     # development | production | test

# Configuración para autenticación con JWT (JSON Web Tokens)
JWT_SECRET=9dKfL2s8XzQpR7mN4vT1yH6uW0bC3aE5jG8kL2pM  # Clave secreta para firmar tokens (mantener privada)
JWT_EXPIRES_IN=2h        # Tiempo de expiración del token

# Configuración del servidor SMTP para envío de correos
SMTP_HOST=smtp.gmail.com                # Servidor SMTP (Gmail)
SMTP_PORT=587                           # Puerto TLS
SMTP_USER=notificaciones.app@gmail.com  # Correo desde el que se envían emails
SMTP_PASS=abcd efgh ijkl mnop           # App Password (no usar contraseña real)

# Configuración de CORS (orígenes permitidos)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # URLs permitidas

# URL del frontend (para redirecciones, enlaces en correos, etc.)
FRONTEND_URL=http://localhost:5173